#!/bin/sh
# generate local dev creds

set -eu

if [ -f tmp/tls/tls.crt ]  && [ -f tmp/tls/tls.key ]  && [ -f tmp/tls/ca.crt ]; then
  exit
fi

set -x
: bin/setup

rm -rf tmp/tls
mkdir -p tmp/tls

mkcert -install

mkcert -client -ecdsa \
  -cert-file tmp/tls/tls.crt \
  -key-file tmp/tls/tls.key \
  localhost 127.0.0.1 ::1 spiffe://local/dev

cp "$(mkcert -CAROOT)/rootCA.pem" tmp/tls/ca.crt
